name: Full Test and Governance Verification Suite

on:
  push:
    branches:
      - main
      - develop
  pull_request:
    branches:
      - main
      - develop
  schedule:
    - cron: "0 3 * * *"
  workflow_dispatch: {}

permissions:
  contents: read
  security-events: write
  issues: write

jobs:

  unit-tests-python:
    name: Python Unit Tests
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Check for Python project files
        id: check
        run: |
          if [ -f requirements.txt ] || [ -f pyproject.toml ]; then
            echo "found=true" >> "$GITHUB_OUTPUT"
          else
            echo "found=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Install dependencies
        if: steps.check.outputs.found == 'true'
        run: |
          pip install -r requirements.txt || true
          pip install pytest pytest-cov

      - name: Run unit tests
        if: steps.check.outputs.found == 'true'
        run: |
          if [ -d tests/unit ]; then
            pytest tests/unit -v --cov=. --cov-report=xml
          else
            echo "No tests/unit directory found, skipping."
          fi

  unit-tests-node:
    name: Node.js Unit Tests
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "20"

      - name: Check for package.json
        id: check
        run: |
          if [ -f package.json ]; then
            echo "found=true" >> "$GITHUB_OUTPUT"
          else
            echo "found=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Install and test
        if: steps.check.outputs.found == 'true'
        run: |
          npm ci
          npm test --if-present -- --coverage

  integration-tests:
    name: Integration Tests
    runs-on: ubuntu-latest
    needs:
      - unit-tests-python
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Check for docker-compose file
        id: check
        run: |
          if [ -f docker-compose.yml ] || [ -f docker-compose.yaml ]; then
            echo "found=true" >> "$GITHUB_OUTPUT"
          else
            echo "found=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Start stack
        if: steps.check.outputs.found == 'true'
        run: docker compose up -d

      - name: Wait for services
        if: steps.check.outputs.found == 'true'
        run: sleep 15

      - name: Run integration tests
        if: steps.check.outputs.found == 'true'
        run: |
          pip install pytest
          if [ -d tests/integration ]; then
            pytest tests/integration -v
          else
            echo "No tests/integration directory found, skipping."
          fi

      - name: Dump logs on failure
        if: failure()
        run: docker compose logs || true

      - name: Tear down
        if: always() && steps.check.outputs.found == 'true'
        run: docker compose down -v || true

  dvr-pipeline-tests:
    name: DVR Pipeline Tests
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Run DVR pipeline test suite
        run: |
          pip install pytest
          if [ -d tests/dvr ]; then
            pytest tests/dvr -v
          else
            echo "No tests/dvr directory found, skipping."
          fi

      - name: Symlink escape detection test
        run: |
          if [ -f tests/dvr/test_symlink_escape.py ]; then
            pytest tests/dvr/test_symlink_escape.py -v
          else
            echo "Symlink escape detection test not implemented yet."
          fi

  dependency-scan-python:
    name: pip-audit
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Run pip-audit
        run: |
          pip install pip-audit
          if [ -f requirements.txt ]; then
            pip-audit -r requirements.txt --format json --output pip-audit-report.json || true
            pip-audit -r requirements.txt || true
          else
            echo "No requirements.txt found, skipping."
          fi

      - name: Upload report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: pip-audit-report
          path: pip-audit-report.json
          if-no-files-found: ignore

  dependency-scan-node:
    name: npm audit
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Set up Node.js
        uses: actions/setup-node@v4
        with:
          node-version: "20"

      - name: Run npm audit
        run: |
          if [ -f package.json ]; then
            npm install --package-lock-only || true
            npm audit --json > npm-audit-report.json || true
            npm audit --audit-level=high || true
          else
            echo "No package.json found, skipping."
          fi

      - name: Upload report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: npm-audit-report
          path: npm-audit-report.json
          if-no-files-found: ignore

  container-scan:
    name: Trivy Container Scan
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Check for Dockerfile
        id: check
        run: |
          if [ -f Dockerfile ]; then
            echo "found=true" >> "$GITHUB_OUTPUT"
          else
            echo "found=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Build image
        if: steps.check.outputs.found == 'true'
        run: docker build -t local/scan-target:latest .

      - name: Run Trivy vulnerability scanner
        if: steps.check.outputs.found == 'true'
        uses: aquasecurity/trivy-action@0.24.0
        with:
          image-ref: "local/scan-target:latest"
          format: "sarif"
          output: "trivy-results.sarif"
          severity: "CRITICAL,HIGH"
          exit-code: "0"

      - name: Upload Trivy results
        if: steps.check.outputs.found == 'true'
        uses: github/codeql-action/upload-sarif@v3
        with:
          sarif_file: "trivy-results.sarif"

  codeql:
    name: CodeQL Static Analysis
    runs-on: ubuntu-latest
    permissions:
      security-events: write
      contents: read
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Initialize CodeQL
        uses: github/codeql-action/init@v3
        with:
          languages: python, javascript

      - name: Autobuild
        uses: github/codeql-action/autobuild@v3

      - name: Perform CodeQL Analysis
        uses: github/codeql-action/analyze@v3

  ugc-governance-checks:
    name: UGC Infra Governance Checks
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Check Redis authentication
        run: |
          if [ -f docker-compose.yml ]; then
            if grep -q "requirepass" docker-compose.yml || grep -q "REDIS_PASSWORD" docker-compose.yml; then
              echo "Redis authentication configured."
            else
              echo "WARNING: Redis appears to run without authentication."
            fi
          else
            echo "No docker-compose.yml found, skipping."
          fi

      - name: Check Keycloak image tag
        run: |
          if [ -f docker-compose.yml ]; then
            if grep -E "keycloak/keycloak:latest" docker-compose.yml; then
              echo "WARNING: Keycloak image is pinned to latest."
            else
              echo "Keycloak image tag looks pinned."
            fi
          else
            echo "No docker-compose.yml found, skipping."
          fi

      - name: Check for Human Review Gate in docs
        run: |
          if [ -d docs ]; then
            if grep -qri "human review gate" docs/; then
              echo "Human Review Gate reference found."
            else
              echo "WARNING: Human Review Gate not referenced in docs."
            fi
          else
            echo "No docs directory found, skipping."
          fi

  summary:
    name: Aggregate All Results
    needs:
      - unit-tests-python
      - unit-tests-node
      - integration-tests
      - dvr-pipeline-tests
      - dependency-scan-python
      - dependency-scan-node
      - container-scan
      - codeql
      - ugc-governance-checks
    if: always()
    runs-on: ubuntu-latest
    steps:
      - name: Report status of every job
        run: |
          echo "unit-tests-python: ${{ needs.unit-tests-python.result }}"
          echo "unit-tests-node: ${{ needs.unit-tests-node.result }}"
          echo "integration-tests: ${{ needs.integration-tests.result }}"
          echo "dvr-pipeline-tests: ${{ needs.dvr-pipeline-tests.result }}"
          echo "dependency-scan-python: ${{ needs.dependency-scan-python.result }}"
          echo "dependency-scan-node: ${{ needs.dependency-scan-node.result }}"
          echo "container-scan: ${{ needs.container-scan.result }}"
          echo "codeql: ${{ needs.codeql.result }}"
          echo "ugc-governance-checks: ${{ needs.ugc-governance-checks.result }}"
          
